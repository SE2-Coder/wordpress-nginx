# ===================================================================
# Variables de Entorno para WordPress Stack
# ===================================================================

# --- Dominio y Routing ---
DOMAIN=midominio.com

# --- Versión de PHP (7.4, 8.0, 8.1, 8.2, 8.3, 8.4) ---
PHP_VERSION=8.2

# --- Base de Datos (MariaDB) ---
DB_ROOT_PASSWORD=ChangeThisToASecureRootPassword123!
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=ChangeThisToASecureDbPassword123!
TABLE_PREFIX=wp_

# --- Redis ---
REDIS_PASSWORD=ChangeThisToASecureRedisPassword123!

# --- WordPress (Opcional, para auto-instalación) ---
WP_TITLE=Mi Sitio Web
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=ChangeThisToASecureAdminPassword123!
WP_ADMIN_EMAIL=admin@midominio.com